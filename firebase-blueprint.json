{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Information about a garden curator.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique Firebase Auth ID" },
        "displayName": { "type": "string", "description": "User's full name" },
        "email": { "type": "string", "format": "email", "description": "User's email address" },
        "photoURL": { "type": "string", "format": "uri", "description": "Profile picture URL" },
        "isPro": { "type": "boolean", "description": "Whether the user is a pro member" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the user joined" }
      },
      "required": ["uid", "email"]
    },
    "Inhabitant": {
      "title": "Garden Inhabitant",
      "description": "A specific plant entry in the user's garden inventory (PLM Entity).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique document ID (UUID)" },
        "ownerUid": { "type": "string", "description": "The UID of the user who owns this inhabitant" },
        "name": { "type": "string", "description": "Common name of the plant" },
        "latinName": { "type": "string", "description": "Latin botanical name" },
        "cultivar": { "type": "string", "description": "Specific cultivar or variety" },
        "accessionDate": { "type": "string", "format": "date", "description": "Date the plant was acquired or started" },
        "sourceVendor": { "type": "string", "description": "Where the plant was sourced from" },
        "parentId": { "type": "string", "description": "ID of the parent plant for propagation/cloning tracking" },
        "status": { "type": "string", "enum": ["Healthy", "Struggling", "Excellent", "Dormant", "Flowering", "Vegetative", "Pending"], "description": "Current health status" },
        "type": { "type": "string", "enum": ["Herb", "Vegetable", "Flower", "Annual", "Perennial"], "description": "Category of the plant" },
        "vigorIndex": { "type": "number", "description": "Calculated vigor index (0-100)" },
        "daysActive": { "type": "integer", "description": "Number of days since planting" },
        "image": { "type": "string", "format": "uri", "description": "Image URL for the plant" },
        "progress": { "type": "integer", "description": "Growth progress percentage (0-100)" },
        "nextWatering": { "type": "string", "description": "Next scheduled watering time" },
        "needsWater": { "type": "boolean", "description": "Whether the plant currently needs water" },
        "description": { "type": "string", "description": "Detailed botanical description" },
        "waterFreq": { "type": "string", "description": "Watering frequency requirement" },
        "sunExposure": { "type": "string", "description": "Sunlight requirement" },
        "notes": { "type": "string", "description": "Personalized curator notes" },
        "gridPosition": { 
          "type": "object", 
          "properties": {
            "x": { "type": "integer" },
            "y": { "type": "integer" }
          },
          "description": "Position on the garden grid"
        },
        "plotId": { "type": "string", "description": "ID of the SpatialPlot this plant is in" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the inhabitant was added to the inventory" }
      },
      "required": ["ownerUid", "name", "type", "createdAt"]
    },
    "SpatialPlot": {
      "title": "Spatial Plot",
      "description": "A coordinate-based grid system for mapping garden beds.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "description": "The UID of the user" },
        "name": { "type": "string", "description": "Name of the bed (e.g., Cherrywood #3)" },
        "description": { "type": "string", "description": "Optional description of the plot" },
        "status": { "type": "string", "enum": ["Active", "Planned", "Retired", "Quarantine"], "description": "Current status of the plot" },
        "gridConfig": {
          "type": "object",
          "properties": {
            "rows": { "type": "integer" },
            "cols": { "type": "integer" }
          }
        },
        "irrigationZone": { "type": "string", "description": "Irrigation zone ID" },
        "plantFamily": { "type": "string", "description": "Primary plant family in this bed" },
        "soilType": { "type": "string", "description": "Type of soil used" },
        "healthStatus": { "type": "string", "enum": ["Excellent", "Stable", "Stressed", "Critical"], "description": "Overall health of the plot" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "name", "status", "createdAt"]
    },
    "EventLog": {
      "title": "Event Log",
      "description": "A polymorphic log for treatments, weeding, and observations.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "description": "The UID of the user" },
        "targetId": { "type": "string", "description": "ID of the Inhabitant or SpatialPlot" },
        "targetType": { "type": "string", "enum": ["Inhabitant", "SpatialPlot"] },
        "type": { "type": "string", "enum": ["Treatment", "Weeding", "Observation", "Fertilizing", "Watering"] },
        "date": { "type": "string", "format": "date-time" },
        "dosage_ml": { "type": "number", "description": "Dosage in milliliters" },
        "active_ingredient": { "type": "string", "description": "Active chemical or organic ingredient" },
        "phenological_stage": { "type": "string", "description": "Current growth stage (e.g., Seedling, Flowering)" },
        "pest_pressure": { "type": "integer", "description": "Pest pressure index (0-10)" },
        "evapotranspiration": { "type": "number", "description": "ET rate for the period" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "targetId", "type", "date", "createdAt"]
    },
    "Task": {
      "title": "Garden Task",
      "description": "A daily or weekly must-do task.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "description": "The UID of the user" },
        "plotId": { "type": "string", "description": "The ID of the plot (optional)" },
        "plantId": { "type": "string", "description": "The ID of the plant (optional)" },
        "plantName": { "type": "string", "description": "Name of the plant (optional)" },
        "task": { "type": "string", "description": "Description of the task" },
        "completed": { "type": "boolean", "description": "Whether the task is finished" },
        "frequency": { "type": "string", "enum": ["Daily", "Weekly"], "description": "How often the task repeats" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "task", "completed", "createdAt"]
    },
    "TaskHistory": {
      "title": "Task History Log",
      "description": "A historical record of a completed task.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "description": "The UID of the user" },
        "taskId": { "type": "string", "description": "Original task ID" },
        "task": { "type": "string", "description": "Description of the task" },
        "plotId": { "type": "string", "description": "The ID of the plot" },
        "plantId": { "type": "string", "description": "The ID of the plant" },
        "plantName": { "type": "string", "description": "Name of the plant" },
        "category": { "type": "string", "description": "Category or frequency of the task" },
        "completionDate": { "type": "string", "format": "date-time", "description": "When the task was completed" },
        "status": { "type": "string", "description": "Archive status" }
      },
      "required": ["ownerUid", "task", "completionDate"]
    },
    "Expense": {
      "title": "Garden Expense",
      "description": "A record of an expense related to a specific plot.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "description": "The UID of the user" },
        "plotId": { "type": "string", "description": "The ID of the plot" },
        "plotName": { "type": "string", "description": "Name of the plot" },
        "item": { "type": "string", "description": "The item or service purchased" },
        "amount": { "type": "number", "description": "The cost of the item" },
        "category": { "type": "string", "enum": ["Seeds", "Soil", "Tools", "Water", "Fertilizer", "Other"], "description": "Category of the expense" },
        "date": { "type": "string", "format": "date", "description": "The date of the expense" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "plotId", "item", "amount", "date", "createdAt"]
    },
    "CalendarEvent": {
      "title": "Calendar Event",
      "description": "A manually added or automatically generated event in the garden calendar.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "description": "The UID of the user" },
        "title": { "type": "string", "description": "Title of the event" },
        "description": { "type": "string", "description": "Details about the event" },
        "date": { "type": "string", "format": "date", "description": "The date of the event (YYYY-MM-DD)" },
        "type": { "type": "string", "enum": ["Manual", "Watering", "Fertilizing", "Pruning", "Harvesting", "Pest Control", "Soil Amendment", "Propagation", "Task", "Weeding", "Treatment"], "description": "Type of event" },
        "priority": { "type": "string", "enum": ["Low", "Medium", "High"], "description": "Priority level" },
        "recurrence": { "type": "string", "enum": ["None", "Daily", "Weekly", "Bi-weekly"], "description": "Recurrence pattern" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "title", "date", "type", "createdAt"]
    },
    "MaintenanceLog": {
      "title": "Maintenance Log",
      "description": "A record of a maintenance activity in a specific plot.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "description": "The UID of the user" },
        "plotId": { "type": "string", "description": "The ID of the plot" },
        "plotName": { "type": "string", "description": "Name of the plot" },
        "action": { "type": "string", "description": "The action performed (e.g., Pruning, Fertilizing)" },
        "notes": { "type": "string", "description": "Additional notes about the maintenance" },
        "date": { "type": "string", "format": "date", "description": "The date of the maintenance" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "plotId", "action", "date", "createdAt"]
    },
    "GlobalEvent": {
      "title": "Global Event",
      "description": "A centralized log for all garden activities (SSOT).",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "description": "The UID of the user" },
        "category": { "type": "string", "description": "Source collection category" },
        "eventType": { "type": "string", "description": "Type of event (e.g., Weeding, Treatment)" },
        "data": { "type": "object", "description": "Polymorphic event data" },
        "calendarTitle": { "type": "string" },
        "calendarDescription": { "type": "string" },
        "xpEarned": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "eventType", "timestamp"]
    },
    "UserProgress": {
      "title": "User Progress",
      "description": "Gamification metrics for the user.",
      "type": "object",
      "properties": {
        "xp": { "type": "number" },
        "level": { "type": "number" },
        "streak": { "type": "number" },
        "lastEventDate": { "type": "string", "format": "date" },
        "totalEvents": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["xp", "level"]
    },
    "CustomTaxonomy": {
      "title": "Custom Taxonomy",
      "description": "User-discovered species or weeds.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["weed", "plant"] },
        "threat": { "type": "number" },
        "icon": { "type": "string" },
        "discoveredBy": { "type": "string" },
        "discoveredAt": { "type": "string", "format": "date-time" },
        "imageUrl": { "type": "string", "format": "uri" },
        "isCustom": { "type": "boolean" }
      },
      "required": ["name", "type", "discoveredBy"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "User profile documents."
    },
    "/user_progress/{uid}": {
      "schema": "UserProgress",
      "description": "Gamification progress for each user."
    },
    "/global_events/{id}": {
      "schema": "GlobalEvent",
      "description": "Master log for all garden events."
    },
    "/custom_taxonomy/{id}": {
      "schema": "CustomTaxonomy",
      "description": "User-defined species and weeds."
    },
    "/inhabitants/{id}": {
      "schema": "Inhabitant",
      "description": "Main garden inhabitant collection (PLM)."
    },
    "/spatial_plots/{id}": {
      "schema": "SpatialPlot",
      "description": "Collection of spatial garden beds."
    },
    "/event_logs/{id}": {
      "schema": "EventLog",
      "description": "Polymorphic collection of garden events and treatments."
    },
    "/calendar_events/{eventId}": {
      "schema": "CalendarEvent",
      "description": "Collection of calendar events."
    },
    "/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Collection of garden expenses."
    },
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Collection of garden tasks."
    },
    "/task_history/{historyId}": {
      "schema": "TaskHistory",
      "description": "Historical log of completed tasks."
    }
  }
}
